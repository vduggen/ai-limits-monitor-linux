[Unit]
# The installed unit name remains ai-limits-widget.service for compatibility.
Description=Linux Mint AI Limits Applet usage monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/linux-mint-ai-limits-applet
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node %h/linux-mint-ai-limits-applet/dist/index.js watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
