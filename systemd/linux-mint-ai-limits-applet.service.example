[Unit]
# The installed unit name remains ai-limits-widget.service for compatibility.
Description=AI Limits Monitor for Linux usage service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ai-limits-monitor
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node %h/ai-limits-monitor/dist/index.js watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
